# Kết nối development local; không commit .env.local.
# Mật khẩu tài khoản MySQL, KHÔNG phải mật khẩu tài khoản DEMO của ứng dụng.
EDUCONNECT_DB_URL=jdbc:mysql://127.0.0.1:3306/educonnect_dev?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
EDUCONNECT_DB_USERNAME=root
EDUCONNECT_DB_PASSWORD=__ENTER_PASSWORD_LOCALLY__

# Resend SMTP: password là Resend API key; FROM thuộc domain đã xác minh.
EDUCONNECT_MAIL_HOST=smtp.resend.com
EDUCONNECT_MAIL_PORT=465
EDUCONNECT_MAIL_USERNAME=resend
EDUCONNECT_MAIL_PASSWORD=
EDUCONNECT_MAIL_FROM=

